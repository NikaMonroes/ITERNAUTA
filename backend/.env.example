# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/iternauta"

JUMPSELLER_LOGIN_KEY="your_jumpseller_login_key"
JUMPSELLER_AUTH_TOKEN="your_jumpseller_auth_token"
